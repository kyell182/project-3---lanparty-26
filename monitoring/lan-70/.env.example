# Instellingen voor de LAN van 70 deelnemers (zie lan-70/LAN_70_OPSTELLING.md).
# Kopieer naar .env en vul de lege waarden in. .env staat in .gitignore.
#
# Een sterk geheim maak je met:  openssl rand -hex 32

# --- InfluxDB ---
INFLUXDB_ADMIN_USER=lan_admin
INFLUXDB_ADMIN_PASSWORD=
INFLUXDB_TOKEN=
INFLUXDB_ORG=vives_lan
INFLUXDB_BUCKET=netmetrics
INFLUXDB_RETENTION=30d

# --- Grafana ---
GRAFANA_ADMIN_USER=lan_admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000

# --- SNMP ---
# Stel dezelfde community in op pfSense en beide switches (alleen lezen, beperkt tot het IP van deze server).
SNMP_COMMUNITY=

# --- Apparaten die via SNMP bewaakt worden: IP-adressen met komma's ertussen ---
# Een apparaat toevoegen? Zet het IP erbij en draai: docker compose up -d
SNMP_APPARATEN=10.10.10.1,10.10.10.2,10.10.10.3

# --- Doelen voor latency en packet loss (IP's met komma's ertussen) ---
# Bijvoorbeeld een doel op het LAN (de server zelf) en een doel op het internet, voor de uplink.
PING_DOELEN=10.10.20.10,1.1.1.1

# --- Vaste versies, zodat de stack niet verandert tussen test en evenement ---
INFLUXDB_VERSION=2.7
TELEGRAF_VERSION=1.32
GRAFANA_VERSION=11.3.0
